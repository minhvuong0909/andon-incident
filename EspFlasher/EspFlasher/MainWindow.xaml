<Window x:Class="EspFlasher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESP8266 Flasher - Neon Edition"
        Height="1027" Width="950"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        >

    <Window.Resources>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF00F5FF" Offset="0"/>
            <GradientStop Color="#FF7B2FFF" Offset="0.5"/>
            <GradientStop Color="#FFFF006E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DarkGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1a0033" Offset="0"/>
            <GradientStop Color="#0d001a" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1f1135" Offset="0"/>
            <GradientStop Color="#2a1a4d" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00F5FF" Offset="0"/>
            <GradientStop Color="#00D9FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FF88" Offset="0"/>
            <GradientStop Color="#00CC6A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF00F5" Offset="0"/>
            <GradientStop Color="#FF006E" Offset="1"/>
        </LinearGradientBrush>

        <!-- Neon Button Style -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="#0d001a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GlowBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
                                    Opacity="0.8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00F5FF"
                                                      BlurRadius="20"
                                                      ShadowDepth="0"
                                                      Opacity="0.8"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlowBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F5FF"
                                                          BlurRadius="30"
                                                          ShadowDepth="0"
                                                          Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button (Outlined) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#00F5FF"/>
            <Setter Property="BorderBrush" Value="#00F5FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00F5FF"
                                                  BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1a00F5FF"/>
                                <Setter TargetName="MainBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F5FF"
                                                          BlurRadius="20"
                                                          ShadowDepth="0"
                                                          Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flash Button (Success Green) -->
        <Style x:Key="FlashButton" TargetType="Button" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Background" Value="{StaticResource SuccessGradient}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GlowBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}"
                                    Opacity="0.8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FF88"
                                                      BlurRadius="25"
                                                      ShadowDepth="0"
                                                      Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlowBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00FF88"
                                                          BlurRadius="35"
                                                          ShadowDepth="0"
                                                          Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neon TextBox -->
        <Style x:Key="NeonTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#00F5FF"/>
            <Setter Property="Background" Value="#0f0626"/>
            <Setter Property="BorderBrush" Value="#7B2FFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CaretBrush" Value="#00F5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect Color="#7B2FFF"
                                                  BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.3"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00F5FF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F5FF"
                                                          BlurRadius="15"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neon GroupBox -->
        <Style x:Key="NeonGroupBox" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#00F5FF"/>
            <Setter Property="BorderBrush" Value="#7B2FFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border Background="{StaticResource CardGradient}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7B2FFF"
                                                      BlurRadius="20"
                                                      ShadowDepth="0"
                                                      Opacity="0.4"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#33FF00F5"
                                            CornerRadius="6"
                                            Padding="14,8"
                                            Margin="0,0,0,12"
                                            HorizontalAlignment="Left">
                                        <ContentPresenter ContentSource="Header"
                                                          TextElement.FontWeight="Bold"
                                                          TextElement.FontSize="15"
                                                          TextElement.Foreground="#FF00F5"/>
                                    </Border>

                                    <ContentPresenter Grid.Row="1"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neon ListBox -->
        <Style x:Key="NeonListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#0f0626"/>
            <Setter Property="Foreground" Value="#00F5FF"/>
            <Setter Property="BorderBrush" Value="#7B2FFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#7B2FFF"
                                                  BlurRadius="15"
                                                  ShadowDepth="0"
                                                  Opacity="0.4"/>
                            </Border.Effect>
                            <ScrollViewer>
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#00D9FF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FF00F5"/>
                                <Setter Property="Foreground" Value="#FF00F5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a00F5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.Background>
            <StaticResource ResourceKey="DarkGradient"/>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Background="{StaticResource CardGradient}"
                    BorderBrush="#7B2FFF"
                    BorderThickness="3"
                    CornerRadius="15"
                    Margin="25">
                <Border.Effect>
                    <DropShadowEffect Color="#7B2FFF"
                                      Opacity="0.6"
                                      BlurRadius="40"
                                      ShadowDepth="0"/>
                </Border.Effect>

                <Grid Margin="35">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header with Neon Glow -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,30">
                        <TextBlock Text="⚡ ESP8266 FLASHER"
                                   FontSize="36"
                                   FontWeight="Black"
                                   Foreground="#00F5FF"
                                   HorizontalAlignment="Center"
                                   FontFamily="Arial Black">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#00F5FF"
                                                  BlurRadius="20"
                                                  ShadowDepth="0"
                                                  Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                                   FontSize="12"
                                   Foreground="#FF00F5"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"
                                   Opacity="0.6"/>
                        <TextBlock Text="NEON EDITION · FLASH YOUR FIRMWARE WITH STYLE"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#7B2FFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"
                                   />
                    </StackPanel>

                    <!-- Firmware Section -->
                    <GroupBox Grid.Row="1"
                              Header="📁 FIRMWARE FILE"
                              Style="{StaticResource NeonGroupBox}"
                              Margin="0,0,0,20">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtFirmware"
                                     Grid.Column="0"
                                     Style="{StaticResource NeonTextBox}"
                                     Height="40"
                                     IsReadOnly="True"/>

                            <Button x:Name="BtnBrowse"
                                    Grid.Column="1"
                                    Content="BROWSE"
                                    Style="{StaticResource NeonButton}"
                                    Width="120"
                                    Margin="10,0,0,0"
                                    Click="BtnBrowse_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- COM Ports Section -->
                    <GroupBox Grid.Row="2"
                              Header="🔌 COM PORTS"
                              Style="{StaticResource NeonGroupBox}"
                              Margin="0,0,0,20">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="200"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⚠"
                                           Foreground="#FF00F5"
                                           Margin="0,0,8,0"
                                           FontSize="16"/>
                                <TextBlock Text="Select target ports for flashing"
                                           FontSize="12"
                                           Foreground="#00D9FF"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnScan"
                                        Content="🔄 SCAN"
                                        Style="{StaticResource GhostButton}"
                                        Padding="16,8"
                                        Margin="15,0,0,0"
                                        Click="BtnScan_Click"/>
                            </StackPanel>

                            <ListBox x:Name="LstComPorts"
                                     Grid.Row="1"
                                     SelectionMode="Extended"
                                     Style="{StaticResource NeonListBox}"/>
                        </Grid>
                    </GroupBox>

                    <!-- Progress Alert -->
                    <Border x:Name="ProgressPanel"
                            Grid.Row="3"
                            Background="#1a0033"
                            BorderBrush="#FF00F5"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF00F5"
                                              BlurRadius="20"
                                              ShadowDepth="0"
                                              Opacity="0.6"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡"
                                       Foreground="#FF00F5"
                                       FontSize="18"
                                       Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtProgress"
                                       Text="FLASHING IN PROGRESS..."
                                       Foreground="#FF00F5"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Console Log -->
                    <GroupBox Grid.Row="4"
                              Header="💻 CONSOLE OUTPUT"
                              Style="{StaticResource NeonGroupBox}">
                        <TextBox x:Name="TxtLog"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Background="#0a0515"
                                 Foreground="#00D9FF"
                                 BorderThickness="0"
                                 Padding="12"/>
                    </GroupBox>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="5" Margin="0,25,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="EXIT"
                                Style="{StaticResource GhostButton}"
                                Width="110"
                                Click="Button_Click"/>

                        <Button Grid.Column="1"
                                Content="CLEAR LOG"
                                Style="{StaticResource GhostButton}"
                                Width="130"
                                Margin="12,0,0,0"
                                Click="Button_Click_1"/>

                        <Button x:Name="BtnFlash"
                                Grid.Column="3"
                                Content="⚡ FLASH FIRMWARE"
                                Style="{StaticResource FlashButton}"
                                Height="50"
                                Padding="40,0"
                                Click="BtnFlash_Click"/>
                    </Grid>

                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
