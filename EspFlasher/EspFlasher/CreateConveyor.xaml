<Window x:Class="EspFlasher.CreateConveyor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Conveyor - Neon Edition"
        Height="663"
        Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF00F5FF" Offset="0"/>
            <GradientStop Color="#FF7B2FFF" Offset="0.5"/>
            <GradientStop Color="#FFFF006E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DarkGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1a0033" Offset="0"/>
            <GradientStop Color="#0d001a" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1f1135" Offset="0"/>
            <GradientStop Color="#2a1a4d" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00F5FF" Offset="0"/>
            <GradientStop Color="#00D9FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FF88" Offset="0"/>
            <GradientStop Color="#00CC6A" Offset="1"/>
        </LinearGradientBrush>

        <!-- Neon Button Style -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuccessGradient}"/>
            <Setter Property="Foreground" Value="#0d001a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GlowBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
                                    Opacity="0.8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FF88"
                                                      BlurRadius="20"
                                                      ShadowDepth="0"
                                                      Opacity="0.8"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.FontWeight="Bold"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlowBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00FF88"
                                                          BlurRadius="30"
                                                          ShadowDepth="0"
                                                          Opacity="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button (Cancel) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF006E"/>
            <Setter Property="BorderBrush" Value="#FF006E"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF006E"
                                                  BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1aFF006E"/>
                                <Setter TargetName="MainBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF006E"
                                                          BlurRadius="20"
                                                          ShadowDepth="0"
                                                          Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neon TextBox -->
        <Style x:Key="NeonTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#00F5FF"/>
            <Setter Property="Background" Value="#0f0626"/>
            <Setter Property="BorderBrush" Value="#7B2FFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CaretBrush" Value="#00F5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#7B2FFF"
                                                  BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.3"/>
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00F5FF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F5FF"
                                                          BlurRadius="15"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#9D4EFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neon ComboBox -->
        <Style x:Key="NeonComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#00F5FF"/>
            <Setter Property="Background" Value="#0f0626"/>
            <Setter Property="BorderBrush" Value="#7B2FFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7B2FFF"
                                                      BlurRadius="10"
                                                      ShadowDepth="0"
                                                      Opacity="0.3"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                    <ToggleButton Grid.Column="1"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Width="40"
                                                  Cursor="Hand">
                                        <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                              Fill="#00F5FF"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True">
                                <Border Background="#1f1135"
                                        BorderBrush="#7B2FFF"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#7B2FFF"
                                                          BlurRadius="20"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#00F5FF"/>
                                <Setter TargetName="MainBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00F5FF"
                                                          BlurRadius="15"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#9D4EFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#00D9FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FF00F5"/>
                                <Setter Property="Foreground" Value="#FF00F5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4DFF00F5"/>
                                <Setter Property="Foreground" Value="#FF00F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label Style -->
        <Style x:Key="NeonLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF00F5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF00F5"
                                      BlurRadius="8"
                                      ShadowDepth="0"
                                      Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.Background>
            <StaticResource ResourceKey="DarkGradient"/>
        </Grid.Background>

        <Border Background="{StaticResource CardGradient}"
                BorderBrush="#7B2FFF"
                BorderThickness="3"
                CornerRadius="15"
                Margin="20">
            <Border.Effect>
                <DropShadowEffect Color="#7B2FFF"
                                  Opacity="0.7"
                                  BlurRadius="40"
                                  ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,35">
                    <!-- Icon + Title -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#33FF00F5"
                                Width="60"
                                Height="60"
                                CornerRadius="30"
                                Margin="0,0,15,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF00F5"
                                                  BlurRadius="20"
                                                  ShadowDepth="0"
                                                  Opacity="0.7"/>
                            </Border.Effect>
                            <TextBlock Text="🏭"
                                       FontSize="32"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CREATE CONVEYOR"
                                       FontSize="24"
                                       FontWeight="Black"
                                       Foreground="#00F5FF"
                                       >
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#00F5FF"
                                                      BlurRadius="15"
                                                      ShadowDepth="0"
                                                      Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="Initialize new production line system"
                                       FontSize="11"
                                       Foreground="#7B2FFF"
                                       Margin="0,6,0,0"
                                       FontWeight="SemiBold"
                                       />
                        </StackPanel>
                    </Grid>

                    <!-- Separator Line -->
                    <Border Height="2"
                            Background="{StaticResource NeonGradient}"
                            CornerRadius="1"
                            Opacity="0.5"/>
                </StackPanel>

                <!-- Factory Selection -->
                <StackPanel Grid.Row="1" Margin="0,0,0,22">
                    <TextBlock Text="🏢 FACTORY SELECTION"
                               Style="{StaticResource NeonLabel}"/>
                    <ComboBox x:Name="FactoryComboBox"
                              Height="46"
                              Style="{StaticResource NeonComboBox}"
                              ToolTip="Select target factory">
                    </ComboBox>
                </StackPanel>

                <!-- Conveyor Name -->
                <StackPanel Grid.Row="2" Margin="0,0,0,22">
                    <TextBlock Text="📦 CONVEYOR NAME"
                               Style="{StaticResource NeonLabel}"/>
                    <TextBox x:Name="TxtConveyorName"
                             Height="46"
                             Style="{StaticResource NeonTextBox}"
                             ToolTip="Enter conveyor identifier (e.g., Line-A01)"/>
                </StackPanel>

                <!-- Device ID -->
                <StackPanel Grid.Row="3" Margin="0,0,0,22">
                    <TextBlock Text="🔌 ESP DEVICE ID"
                               Style="{StaticResource NeonLabel}"/>
                    <TextBox x:Name="TxtDeviceId"
                             Height="46"
                             Style="{StaticResource NeonTextBox}"
                             IsReadOnly="True"
                             Background="#1a0033"
                             Foreground="#00FF88"
                             ToolTip="Device ID assigned after successful flash"/>
                </StackPanel>

                <!-- Info Alert -->
                <Border Grid.Row="4"
                        Background="#1a0033"
                        BorderBrush="#00FF88"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,30">
                    <Border.Effect>
                        <DropShadowEffect Color="#00FF88"
                                          BlurRadius="15"
                                          ShadowDepth="0"
                                          Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ️"
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Complete all fields before initialization"
                                   FontSize="12"
                                   Foreground="#00FF88"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   />
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid Grid.Row="5" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button
                            Content="✖ CANCEL"
                            Width="130"
                            Height="48"
                            Style="{StaticResource GhostButton}"
                            Margin="144,-9,10,-1" Click="Button_Click"/>

                    <Button Grid.Column="2"
                            x:Name="BtnCreate"
                            Content="✓ CREATE"
                            Width="150"
                            Height="48"
                            Style="{StaticResource NeonButton}"
                            Click="BtnCreate_Click" Margin="0,-11,0,1"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
