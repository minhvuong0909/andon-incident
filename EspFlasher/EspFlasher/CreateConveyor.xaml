<Window x:Class="EspFlasher.CreateConveyor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Conveyor"
        Height="663"
        Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        FontFamily="Segoe UI"
        Background="#F3F4F6">

    <Window.Resources>

        <!-- Basic Brushes -->
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="Success" Color="#16A34A"/>
        <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBorder" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="InputBorderFocus" Color="#2563EB"/>

        <!-- Label Style -->
        <Style x:Key="BaseLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- TextBox Style (NO template override) -->
        <Style x:Key="BaseTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderFocus}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style (NO template override) -->
        <Style x:Key="BaseComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputBorderFocus}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#9CA3AF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Success}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.92"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Outline Button -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Border Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="20">

            <Grid Margin="35">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,28">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#EEF2FF"
                                Width="56"
                                Height="56"
                                CornerRadius="28"
                                Margin="0,0,14,0">
                            <TextBlock Text="🏭"
                                       FontSize="30"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CREATE CONVEYOR"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Initialize new production line system"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1"
                            Background="#E5E7EB"/>
                </StackPanel>

                <!-- Factory Selection -->
                <StackPanel Grid.Row="1" Margin="0,0,0,18">
                    <TextBlock Text="FACTORY SELECTION"
                               Style="{StaticResource BaseLabel}"/>
                    <ComboBox x:Name="FactoryComboBox"
                              Height="46"
                              Style="{StaticResource BaseComboBox}"
                              ToolTip="Select target factory"/>
                </StackPanel>

                <!-- Conveyor Name -->
                <StackPanel Grid.Row="2" Margin="0,0,0,18">
                    <TextBlock Text="CONVEYOR NAME"
                               Style="{StaticResource BaseLabel}"/>
                    <TextBox x:Name="TxtConveyorName"
                             Height="46"
                             Style="{StaticResource BaseTextBox}"
                             ToolTip="Enter conveyor identifier (e.g., Line-A01)"/>
                </StackPanel>

                <!-- Device ID -->
                <StackPanel Grid.Row="3" Margin="0,0,0,18">
                    <TextBlock Text="ESP DEVICE ID"
                               Style="{StaticResource BaseLabel}"/>
                    <TextBox x:Name="TxtDeviceId"
                             Height="46"
                             Style="{StaticResource BaseTextBox}"
                             IsReadOnly="True"
                             Background="#F9FAFB"
                             Foreground="{StaticResource TextSecondary}"
                             ToolTip="Device ID assigned after successful flash"/>
                </StackPanel>

                <!-- Info Alert -->
                <Border Grid.Row="4"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ️"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Complete all fields before initialization"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Grid Grid.Row="5" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="CANCEL"
                            Width="130"
                            Height="48"
                            Style="{StaticResource OutlineButton}"
                            Margin="144,-17,14,7"
                            Click="Button_Click"/>

                    <Button Grid.Column="2"
                            x:Name="BtnCreate"
                            Content="CREATE"
                            Width="150"
                            Height="48"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnCreate_Click"
                            Margin="0,-17,0,7"/>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>